@prefix : <#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix tsioc: <http://rdfs.org/sioc/types#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for Create Activity
:ActivityShape a sh:NodeShape ;
    sh:property [
        sh:path as:actor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "actor" ;
    ] ;
    
    sh:property [
        sh:path as:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "object" ;
    ] .

# Shape for Create Activity
:CreateActivityShape a sh:NodeShape ;
    sh:targetClass as:Create ;
    sh:node :ActivityShape ;
    sh:property [
        sh:path as:object ;
        sh:or (
          [ sh:node :VoteObjectShape ]
          [ sh:node :AnswerObjectShape ]
        )
    ] .

:RemoveActivityShape a sh:NodeShape ;
    sh:targetClass as:Remove ;
    sh:node :ActivityShape ;
    sh:property [
      sh:path as:object ;
      sh:node :VoteObjectShape ;
      sh:nodeKind sh:IRI
    ] .
